{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/console.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "route": "/operator-callback.html", "headers": { "X-Robots-Tag": "noindex, nofollow" } },
    { "route": "/downloads/*", "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow" } }
  ],
  "mimeTypes": { ".exe": "application/octet-stream" },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  }
}
