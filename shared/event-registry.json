{
  "version": 1,
  "definitions": {
    "platform": {"enum":["windows","macos","linux","android","ios","web"]},
    "channel": {"enum":["website","invite","store","direct","unknown","link","email"]},
    "templateCategory": {"enum":["calm","focus","health","learning","connection"]},
    "provider": {"enum":["email","google","microsoft"]},
    "reason": {"enum":["cancelled","network","provider","invalid_token","configuration","unknown"]},
    "habitId": {"type":"uuid"},
    "sessionId": {"type":"uuid"},
    "notificationId": {"type":"uuid"},
    "feedbackId": {"type":"uuid"},
    "localDay": {"type":"date"},
    "result": {"enum":["did","didMore","notToday","undo"]},
    "latencyMs": {"type":"number","min":0,"max":86400000},
    "score": {"type":"number","min":1,"max":7},
    "rating": {"type":"integer","min":1,"max":5},
    "kind": {"enum":["Idea","Bug","Question","Praise","This felt wrong","Rating"]},
    "action": {"enum":["did","snooze","fewer","off","open"]},
    "experiment": {"enum":["reminder_copy_v1"]},
    "variant": {"enum":["control","gentle"]},
    "errorKind": {"enum":["network","authentication","conflict","quota","validation","unavailable","unknown"]}
  },
  "events": {
    "analytics_consent": {"properties":["platform"]},
    "landing_view": {"properties":["platform","channel"]},
    "invite_link_open": {"properties":["platform","channel"]},
    "download_click": {"properties":["platform","channel"]},
    "store_page_view": {"properties":["platform","channel"],"observable":false},
    "installer_started": {"properties":["platform","channel"]},
    "install_completed": {"properties":["platform","channel"]},
    "first_launch": {"properties":["platform","channel","sessionId"]},
    "signin_view": {"properties":["platform","channel","sessionId"]},
    "signin_provider_selected": {"properties":["provider","platform","channel","sessionId"]},
    "signin_succeeded": {"properties":["provider","platform","channel","sessionId","localDay"],"legacy":true},
    "signin_failed": {"properties":["provider","reason","platform","sessionId"]},
    "aspiration_selected": {"properties":["platform","localDay"]},
    "recipe_created": {"properties":["habitId","localDay","platform","templateCategory"],"legacy":true},
    "celebration_practiced": {"properties":["habitId","localDay","platform"]},
    "first_checkin": {"properties":["habitId","localDay","result","platform"]},
    "checkin": {"properties":["habitId","localDay","result","latencyMs","platform"],"legacy":true},
    "comeback": {"properties":["habitId","localDay","platform"]},
    "recipe_doctor_applied": {"properties":["habitId","localDay","platform"]},
    "automaticity_score": {"properties":["habitId","localDay","score","platform"]},
    "reflection": {"properties":["habitId","localDay","score","platform"],"legacy":true},
    "weekly_reflection": {"properties":["habitId","localDay","platform"],"legacy":true},
    "habit_graduated": {"properties":["habitId","localDay","score","platform"],"legacy":true},
    "share_initiated": {"properties":["channel","platform"],"legacy":true},
    "invite_accepted": {"properties":["channel","platform"]},
    "buddy_added": {"properties":["platform"],"observable":false},
    "paywall_view": {"properties":["platform"],"observable":false},
    "trial_start": {"properties":["platform"],"observable":false},
    "purchase": {"properties":["platform"],"observable":false},
    "feedback_submitted": {"properties":["feedbackId","kind","platform"],"legacy":true},
    "rating_prompted": {"properties":["platform","localDay"],"legacy":true},
    "rating_prompt_shown": {"properties":["platform","localDay"]},
    "rated": {"properties":["rating","platform","localDay"]},
    "review_responded": {"properties":["feedbackId","platform"]},
    "reminder_sent": {"properties":["notificationId","habitId","localDay","platform"],"legacy":true},
    "notif_sent": {"properties":["notificationId","habitId","localDay","platform"]},
    "notif_delivered": {"properties":["notificationId","platform"]},
    "notif_opened": {"properties":["notificationId","platform"]},
    "notif_actioned": {"properties":["notificationId","action","platform"]},
    "notif_dismissed": {"properties":["notificationId","platform"]},
    "notif_disabled": {"properties":["platform","localDay"]},
    "session_started": {"properties":["sessionId","platform"]},
    "crash": {"properties":["sessionId","platform","errorKind"]},
    "app_hang": {"properties":["sessionId","platform","latencyMs"]},
    "cold_start": {"properties":["sessionId","platform","latencyMs"]},
    "sync_error": {"properties":["platform","errorKind"]},
    "auth_error": {"properties":["platform","errorKind"]},
    "experiment_exposure": {"properties":["experiment","variant","platform"],"observable":false}
  }
}
